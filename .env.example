# Copy this file to .env (same folder as app.py) and fill in your OWN values.
# NEVER commit the real .env file — only this template should ever go on GitHub.

# Any long random string — used to sign Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=replace_with_a_long_random_string

# The Gmail address FindIt sends match notification emails from
MAIL_USERNAME=your_gmail_address@gmail.com

# A Gmail App Password (NOT your normal Gmail password)
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_PASSWORD=your_16_character_app_password
